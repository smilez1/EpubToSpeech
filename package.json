{
  "name": "epub-to-speech",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "本地运行的 EPUB 阅读器 + 文字转语音朗读",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:lan": "concurrently -k -n api,web -c cyan,magenta \"pnpm dev:api --host 0.0.0.0\" \"pnpm dev:web --host\"",
    "dev:api": "node --no-warnings --experimental-strip-types --experimental-transform-types src/server/index.ts",
    "dev:web": "vite",
    "start": "node --no-warnings --experimental-strip-types --experimental-transform-types src/server/index.ts",
    "start:watch": "node --watch --no-warnings --experimental-strip-types --experimental-transform-types src/server/index.ts",
    "build": "tsc --noEmit -p tsconfig.web.json && vite build",
    "build:portable": "node scripts/build-portable.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test --test-force-exit scripts/test-tts.mjs scripts/test-player.mjs scripts/test-sentences.mjs",
    "test:tts": "node --test --test-force-exit scripts/test-tts.mjs",
    "test:player": "node --test --test-force-exit scripts/test-player.mjs",
    "test:sentences": "node --test --test-force-exit scripts/test-sentences.mjs",
    "test:all": "pnpm typecheck && pnpm test && pnpm smoke:web",
    "sample:epub": "node scripts/make-sample-epub.mjs",
    "piper:server": "node scripts/run-piper-server.mjs",
    "seed:book": "node scripts/seed-sample-book.mjs",
    "smoke:web": "node --no-warnings scripts/smoke-web.mjs",
    "check:reader": "node --no-warnings scripts/check-reader.mjs",
    "check:settings": "node --no-warnings scripts/check-settings-apply.mjs",
    "check:toc": "node --no-warnings scripts/check-toc-nav.mjs",
    "check:ui": "node --no-warnings scripts/check-reader-ui.mjs",
    "check:cross-chapter": "node --no-warnings scripts/check-cross-chapter.mjs",
    "check:voices": "node --no-warnings scripts/check-voices.mjs",
    "check:piper": "node --no-warnings scripts/check-piper-engine.mjs",
    "check:piper-noise": "node --no-warnings scripts/check-piper-noise.mjs",
    "check:voices-lines-menu": "node --no-warnings scripts/check-voices-lines-menu.mjs",
    "check:autodiscover": "node --no-warnings scripts/check-autodiscover.mjs",
    "check:popup": "node --no-warnings scripts/check-popup.mjs",
    "diagnose:layout": "node --no-warnings scripts/diagnose-layout.mjs",
    "diagnose:toc": "node --no-warnings scripts/diagnose-toc.mjs",
    "check:utf8": "node --no-warnings scripts/check-utf8.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm smoke:web && pnpm check:reader",
    "preview": "vite preview"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "@fastify/multipart": "^10.1.1",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.19"
  }
}
