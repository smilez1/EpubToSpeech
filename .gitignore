.venv-tts/
__pycache__/
*.pyc

# 语音模型：体积大且各有许可（chaowen 为 CC0，其余非商业/未知），
# 不随仓库分发；用应用内「语音包」页或 README 的地址自行获取。
models/

# 书库数据（含用户导入的 EPUB，涉及版权与隐私）
data/

# 构建/测试的临时目录（便携包缓存、浏览器 profile 等）
.tmp/

# 本地测试音频输出
samples/

